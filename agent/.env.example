# agent/.env is a symlink to the repo-root .env (gitignored). Keys used by the agent:

# Model credentials (Google AI Studio key, or Vertex AI)
GEMINI_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global

# Gemini model used by classify_intent
AGENT_MODEL=gemini-3.8-flash

# Read-only Wazuh MCP server (wazuh_mcp)
MCP_URL=http://127.0.0.1:8020/mcp
